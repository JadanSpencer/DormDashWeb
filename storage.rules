rules_version = '2';
// Firebase Storage rules for DormDash.
//
// The app does not upload or read any files through Firebase Storage today,
// so everything is locked. This closes a public bucket: nobody can list,
// read, upload or overwrite files through the Storage API.
// (Files you add yourself in the Firebase console are unaffected, and any
// existing "download URLs" with a token keep working.)
//
// If you add uploads later (e.g. profile photos), allow only the owner:
//   match /users/{uid}/{file=**} {
//     allow read: if request.auth != null;
//     allow write: if request.auth != null && request.auth.uid == uid
//                  && request.resource.size < 5 * 1024 * 1024
//                  && request.resource.contentType.matches('image/.*');
//   }
// Account deletion already removes users/{uid}/ (functions/src/index.ts).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
