{
  "expo": {
    "name": "Runner",
    "slug": "dormdash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "dormdash",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5C0D16"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dormdash.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#9B1B22"
      },
      "package": "com.dormdash.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Runner",
      "shortName": "Runner",
      "description": "Order food and essentials on campus. Students run it to your door.",
      "themeColor": "#9B1B22",
      "backgroundColor": "#F4EEE3",
      "lang": "en"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Runner uses your location to show your position on the map while you deliver.",
          "locationWhenInUsePermission": "Runner uses your location to show your position on the map while you deliver."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#A91F1D",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "18c72c59-4aeb-40ed-80d8-56715d0c010b"
      }
    }
  }
}
